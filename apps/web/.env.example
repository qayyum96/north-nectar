# Copy to .env.local for local development. Never commit real secrets.

# Public base URL, used for canonical URLs, sitemap, Open Graph and JSON-LD. No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# "production" allows search engines to index the site. Any other value (e.g. "preview")
# makes robots.txt disallow everything and adds noindex to every page.
NEXT_PUBLIC_SITE_ENV=development

# Catalogue source: "supabase" (the database, managed in the admin) or "seed" (the files in
# packages/data/src/seed, useful offline). Orders, messages and newsletter always use Supabase.
CATALOG_SOURCE=supabase

# Show draft products for local layout testing. Ignored when NEXT_PUBLIC_SITE_ENV=production.
CATALOG_INCLUDE_DRAFTS=false

# --- Supabase (Project Settings -> API keys / Data API) ------------------------------------
# Project URL, e.g. https://abcdefghijkl.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_...). Safe in the browser: row level security limits it.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret key (sb_secret_...). Server only, KEEP PRIVATE. Used to place orders and save messages.
SUPABASE_SERVICE_ROLE_KEY=

# Optional, only for running `pnpm db:migrate` / `pnpm db:seed` from this computer.
# Connect -> Session pooler (port 5432), with the database password percent-encoded.
SUPABASE_DB_URL=

# --- Planned (not used yet) ---------------------------------------------------------------
# Transactional email (Resend free plan) for order and message notifications
# RESEND_API_KEY=
# NOTIFY_EMAIL=info@northnectar.com
