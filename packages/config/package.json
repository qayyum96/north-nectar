{
  "name": "@northnectar/config",
  "version": "0.0.0",
  "private": true,
  "description": "Shared TypeScript, ESLint, Prettier and Tailwind configuration.",
  "type": "module",
  "exports": {
    "./prettier": "./prettier/index.mjs",
    "./eslint/base": "./eslint/base.mjs",
    "./eslint/next": "./eslint/next.mjs",
    "./tsconfig/base.json": "./tsconfig/base.json",
    "./tsconfig/nextjs.json": "./tsconfig/nextjs.json",
    "./tsconfig/library.json": "./tsconfig/library.json",
    "./tailwind/theme.css": {
      "style": "./tailwind/theme.css",
      "default": "./tailwind/theme.css"
    }
  },
  "dependencies": {
    "@eslint/js": "9.39.5",
    "eslint-config-next": "16.4.6",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "globals": "17.14.0",
    "prettier-plugin-tailwindcss": "0.8.1",
    "typescript-eslint": "8.73.0"
  },
  "peerDependencies": {
    "eslint": "^9.39.0",
    "prettier": "^3.10.0",
    "typescript": "~6.0.3"
  }
}
