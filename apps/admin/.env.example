# Copy to .env.local. Never commit real secrets. Use the SAME Supabase values as apps/web.

# --- Supabase (Project Settings -> API keys / Data API) ------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_...). Staff sign in with it; row level security checks roles.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret key (sb_secret_...). Server only, KEEP PRIVATE.
SUPABASE_SERVICE_ROLE_KEY=

# Optional, only for the database scripts (pnpm db:migrate, db:seed, admin:make-owner).
# Connect -> Session pooler (port 5432), with the database password percent-encoded.
SUPABASE_DB_URL=

# Address of the website, for "View online store" links and product images. No trailing slash.
NEXT_PUBLIC_STOREFRONT_URL=http://localhost:3000

# Address of this admin, used in password reset and invite links. Set it in production (e.g.
# https://admin.northnectar.com) so links never depend on request headers. No trailing slash.
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001

# Lets the admin refresh the website straight after a product or category is saved.
# Any long random string; use the same value in apps/web and apps/admin. KEEP PRIVATE.
REVALIDATE_SECRET=
