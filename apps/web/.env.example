# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Transactional email for contact form / order notifications
# RESEND_API_KEY=
# CONTACT_INBOX_EMAIL=info@northnectar.com
