{
  "name": "northnectar",
  "private": true,
  "description": "North Nectar monorepo: marketing and e-commerce website, shared packages and (later) the admin portal.",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@northnectar/web",
    "build": "turbo run build",
    "start": "pnpm --filter @northnectar/web start",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck",
    "prepare": "husky",
    "db:migrate": "node scripts/db.mjs migrate",
    "db:status": "node scripts/db.mjs status",
    "db:seed": "tsx scripts/db-seed.mts",
    "admin:make-owner": "node scripts/make-owner.mjs",
    "media:to-r2": "node scripts/media-to-r2.mjs"
  },
  "devDependencies": {
    "@northnectar/config": "workspace:*",
    "eslint": "9.39.5",
    "husky": "9.1.7",
    "lint-staged": "17.6.1",
    "postgres": "3.4.7",
    "prettier": "3.10.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tsx": "4.20.6",
    "turbo": "2.11.13",
    "typescript": "6.0.3"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "eslint --flag v10_config_lookup_from_file --fix --no-warn-ignored",
      "prettier --write"
    ],
    "*.{json,md,css,yml,yaml}": [
      "prettier --write"
    ]
  }
}
